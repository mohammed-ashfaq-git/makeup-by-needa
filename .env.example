# REQUIRED IN PRODUCTION
# MySQL connection URL. Percent-encode reserved characters in the password.
DATABASE_URL="mysql://app_user:replace-with-a-secret@db-host:3306/makeup_by_needa"

# Canonical public HTTPS URL. Set before `npm run build`; no trailing path.
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# OPTIONAL IN PRODUCTION
# Strong one-time secret for /admin/setup. Leave unset only when first-admin
# setup is protected by another trusted deployment process.
# ADMIN_SETUP_SECRET="replace-with-a-long-random-secret"

# DEVELOPMENT ONLY
# For local work, replace the production values above with local equivalents,
# for example:
# DATABASE_URL="mysql://makeup_by_needa:local-password@127.0.0.1:3307/makeup_by_needa"
# NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"
# NODE_ENV is set by Next.js commands; do not set it manually for normal use.
# The E2E browser scripts optionally honour these executable-path overrides:
# CHROME_PATH="/path/to/chromium"
# CHROME_LD_LIBRARY_PATH="/path/to/chromium/libraries"
