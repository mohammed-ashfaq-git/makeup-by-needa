# ============================================================
# Makeup by Needa - Environment Variables
# Copy this file to .env.local and configure for your environment
# NEVER commit real credentials to repository
# ============================================================

# ------------------------------------------------------------
# Database - MySQL (Required for Production)
# Hostinger MySQL format: mysql://user:password@host:port/database
# Example: DATABASE_URL="mysql://u123456789_makeup:YourPassword@localhost:3306/u123456789_makeupbyneeda"
# ------------------------------------------------------------
DATABASE_URL="mysql://user:password@localhost:3306/makeup_by_needa"

# ------------------------------------------------------------
# Business Configuration (Optional - overrides DB if needed)
# ------------------------------------------------------------
BUSINESS_INQUIRY_EMAIL=aurastudioneeda@gmail.com

# ------------------------------------------------------------
# Email Delivery (Optional - uses WhatsApp fallback if not configured)
# ------------------------------------------------------------
# Option 1: Resend
RESEND_API_KEY=

# Option 2: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------------
# Admin Setup - Secure initial admin creation
# ------------------------------------------------------------
# Secret key required to create first admin via /api/admin/setup
# Generate a strong random string: openssl rand -base64 32
ADMIN_SETUP_SECRET=your-secure-random-setup-secret-min-32-chars

# Optional: Create admin via seed script
# ADMIN_EMAIL=admin@makeupbyneeda.com
# ADMIN_PASSWORD=your-secure-password-min-8-chars

# ------------------------------------------------------------
# Authentication - NextAuth or custom JWT secret
# ------------------------------------------------------------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# For custom auth (alternative to NextAuth)
AUTH_SECRET=your-auth-secret-min-32-chars

# ------------------------------------------------------------
# Site Configuration
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://makeupbyneeda.com
NODE_ENV=development
