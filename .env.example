# Copy this file to `.env` and replace every placeholder.
# `.env` is git-ignored — never commit real credentials.

# REQUIRED IN PRODUCTION

# MySQL connection URL (TiDB Cloud, Hostinger MySQL, or any MySQL 8 server).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode reserved characters in the password (for example @ becomes %40).
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:3306/makeup_by_needa"

# Canonical public HTTPS URL, with no trailing path (for example /admin).
# Used for canonical metadata, the XML sitemap, and robots.txt — set it before
# building. Do not include a trailing slash or a path.
NEXT_PUBLIC_SITE_URL="https://your-production-domain.example"


# OPTIONAL IN PRODUCTION

# Protects the one-time first-admin setup at /admin/setup.
# Use a long, unique random value (for example: openssl rand -base64 32).
ADMIN_SETUP_SECRET="replace-with-a-long-random-secret"


# DEVELOPMENT ONLY

# For local development, replace the production values above with your local
# MySQL connection:
# DATABASE_URL="mysql://mbn_app:local-password@127.0.0.1:3306/makeup_by_needa"
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NODE_ENV is set automatically by Next.js.
# Do not set it manually for normal use.

# Optional E2E browser executable overrides:
# CHROME_PATH="/path/to/chromium"
# CHROME_LD_LIBRARY_PATH="/path/to/chromium/libraries"
